# Copy to .env and fill in. .env is gitignored; scripts/run.ps1 loads it at the repo root.
# One KEY=VALUE per line, values single-line and unquoted (quotes become part of the value),
# no inline comments (everything after the first '=' is the value). Base64 '=' padding is fine.

ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_B64=
ENABLE_BANKING_REDIRECT_URL=
# Optional locally: `connect` persists enablebanking.session_id to bank2sheets-state.properties.
# Required on the GitHub Actions runner (ENABLE_BANKING_SESSION_ID secret).
ENABLE_BANKING_SESSION_ID=
# Optional ASPSP selection (defaults: BBVA / ES / personal).
# The name must match the ASPSP name shown in Enable Banking; the account must be
# linked in the Enable Banking control panel.
ENABLE_BANKING_ASPSP_NAME=
ENABLE_BANKING_ASPSP_COUNTRY=
ENABLE_BANKING_PSU_TYPE=
# Comma-separated provider:accountId[:label] entries, e.g. enablebanking:<uuid> or
# enablebanking:<uuid>:Cuenta Nóminas. The optional label is used in the `Cuenta` column;
# when every entry has one, sync/fetch skip the per-account /details accesses. Leave empty for `connect`.
BANK2SHEETS_ACCOUNTS=
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_SPREADSHEET_ID=
