# Local GitHub config (tokens, personal settings)
.gh-config/

# Maven build output
target/

# Runtime state written by `connect` (connection id only; never credentials)
bank2sheets-state.properties

# Local environment/secrets file (never commit credentials)
.env
.env.*
!.env.example

# Local keys/certificates (never commit)
*.pem
*.key
*.p12
*.jks
*.keystore
